include "stdio.h";

function test_defer_with_return(): Int {
    printf("Before return\n");
    defer printf("Deferred: runs before return\n");
    return 42;
}

function test_defer_with_break() {
    for i in 0...10 {
        if (i == 2) {
            printf("Breaking at i=2\n");
            defer printf("Deferred in if: runs on break\n");
            break;
        }
        printf("i=%d\n", i);
    }
    printf("After loop\n");
}

function main(): Int {
    var result: Int = test_defer_with_return();
    printf("Returned: %d\n", result);
    printf("\n");
    test_defer_with_break();
    return 0;
}
