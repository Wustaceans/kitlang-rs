include "stdio.h";

function swap(pair: (Int, Int)): (Int, Int) {
    return (pair[1], pair[0]);
}

function main(): Int {
    var t = (1, 2);
    printf("%i\n", t[0]);
    printf("%i\n", t[1]);
    t[1] = 42;
    printf("%i\n", t[1]);

    (a, b) = t;
    printf("%i\n", a);
    printf("%i\n", b);

    var s = swap(t);
    printf("%i\n", s[0]);
    printf("%i\n", s[1]);

    return 0;
}
